{
  "manifest_version": 3,
  "name": "长图直贴",
  "version": "1.0.0",
  "description": "一键截取网页长图并自动复制为 PNG，不打开预览页。默认不主动滚动，提供简洁进度提示和滚动兼容模式。",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "offscreen", "clipboardWrite", "contextMenus", "debugger"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "截长图并复制",
    "default_popup": "offscreen.html?view=progress",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
